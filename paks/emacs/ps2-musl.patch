--- a/src/gmalloc.c
+++ b/src/gmalloc.c
@@ -1473,7 +1473,16 @@
 __default_morecore (increment)
      __malloc_ptrdiff_t increment;
 {
-  __ptr_t result = (__ptr_t) __sbrk (increment);
+  /* musl does not support increasing sbrk. A bounded, non-PIE BSS arena
+     also keeps every Lisp pointer in Emacs 20's 28-bit address range.
+     Unused BSS pages do not consume physical RAM. */
+  static union { double align; char bytes[8 * 1024 * 1024]; } arena;
+  static ptrdiff_t used;
+  __ptr_t result;
+  if (increment > (ptrdiff_t) sizeof arena.bytes - used || increment < -used)
+    return NULL;
+  result = arena.bytes + used;
+  used += increment;
   if (result == (__ptr_t) -1)
     return NULL;
   return result;
