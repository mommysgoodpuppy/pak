-- T3 Code: minimal web GUI for coding agents. Nightly AppImage builds.

from "../../../wm-mini/tooling/pakman/src/model.wm" import *;
from "../../../wm-mini/tooling/pakman/src/package.wm" import { serve };
from "../../../wm-mini/tooling/pakman/src/finders.wm" import { githubReleases, releaseCandidates, stableReleases };
from js.module("../../../wm-mini/tooling/pakman/src/host.ts") import unsafe { captures: (String, String) -> Js.Array<String> };

let repo = "pingdotgg/t3code";

-- Tags look like v0.0.46-nightly.20261005.2702; pakman versions replace the
-- dash so they sort and read like 0.0.46.nightly.20261005.2702.
let nightlyTag = "^v(\\d+\\.\\d+\\.\\d+)-nightly\\.(\\d+\\.\\d+)$";

let capturesOf = (pattern, text) => { captures(pattern, text) :> Js.Array.toList };

-- 0.0.46.nightly.20261005.2702 -> 0.0.46-nightly.20261005.2702
let releaseVersion = (version) => {
  match(capturesOf("^(\\d+\\.\\d+\\.\\d+)\\.nightly\\.(\\d+\\.\\d+)$", version)) {
    [_, base, build] => { base ++ "-nightly." ++ build },
    _ => { version }
  }
};

-- v0.0.46-nightly.20261005.2702 -> Some(0.0.46.nightly.20261005.2702)
let nightlyVersion = (tag) => {
  match(capturesOf(nightlyTag, tag)) {
    [_, base, build] => { Some(base ++ ".nightly." ++ build) },
    _ => { None }
  }
};

let appImage = (version) => { "T3-Code-" ++ releaseVersion(version) ++ "-x86_64.AppImage" };

let versions = () => {
  githubReleases(repo)
    :> Task.map(releaseCandidates .{
      ..stableReleases,
      versionOf = nightlyVersion,
      accept = (release) => { release.prerelease },
      assets = (version) => { [appImage(version)] },
      channel = "nightly"
    })
};

let make = (version, _) => {
  let tag = "v" ++ releaseVersion(version);
  let raw = "https://raw.githubusercontent.com/" ++ repo ++ "/" ++ tag;
  .{
    version,
    sources = [
      source("t3-code.AppImage",
        "https://github.com/" ++ repo ++ "/releases/download/" ++ tag ++ "/" ++ appImage(version)),
      source("LICENSE", raw ++ "/LICENSE"),
      source("t3-code.png", raw ++ "/assets/nightly/nightly-universal-1024.png")
    ],
    install = [
      Install("t3-code.AppImage", ".local/lib/t3-code/t3-code.AppImage", Exec),
      Symlink(Own(".local/lib/t3-code/t3-code.AppImage"), ".local/bin/t3-code"),
      Install("t3-code.png", ".local/share/icons/hicolor/1024x1024/apps/t3-code.png", Data),
      Install("LICENSE", ".local/share/licenses/t3-code/LICENSE", Data),
      userDesktopEntry("t3-code", .{
        title = "T3 Code",
        comment = "Minimal web GUI for coding agents",
        exec = cat([ref(Own(".local/bin/t3-code")), lit(" %U")]),
        icon = "t3-code",
        categories = ["Development", "IDE"],
        terminal = false
      })
    ],
    -- AppImages mount themselves with FUSE 2.
    requires = [Base("/usr/lib/libfuse.so.2")]
  }: Package
};

let definition: Definition = .{
  name = "t3-code",
  description = "Minimal web GUI for coding agents (nightly build)",
  homepage = "https://github.com/pingdotgg/t3code",
  license = "MIT",
  target = Host,
  scope = User,
  versions,
  hosts = ["api.github.com"],
  policy = .{ ..defaultPolicy, channel = "nightly" },
  make
};

let main = () => { serve(definition) };
